// The Guetto Barber — Modelagem do banco (PostgreSQL)
// Convenções: PascalCase nos models, snake_case nas tabelas via @@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum RoleName {
  CLIENT
  BARBER
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// ============================================================
// Identidade e papéis
// ============================================================

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  client        Client?
  barber        Barber?
  refreshTokens RefreshToken[]
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

// Refresh tokens hasheados — permitem logout/revogação e múltiplos dispositivos
model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// Perfis específicos
// ============================================================

model Client {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate     DateTime? @map("birth_date")
  notes         String?
  loyaltyPoints Int       @default(0) @map("loyalty_points")

  appointments Appointment[]
  reviews      Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

model Barber {
  id        String  @id @default(uuid())
  userId    String  @unique @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty String?
  bio       String?
  photoUrl  String? @map("photo_url")
  instagram String?
  socials   Json?
  isActive  Boolean @default(true) @map("is_active")

  appointments Appointment[]
  reviews      Review[]
  workingHours WorkingHour[]
  blockedDates BlockedDate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("barbers")
}

// ============================================================
// Catálogo de serviços
// ============================================================

model Service {
  id              String  @id @default(uuid())
  name            String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int     @map("duration_minutes")
  category        String?
  description     String?
  imageUrl        String? @map("image_url")
  isActive        Boolean @default(true) @map("is_active")

  appointmentServices AppointmentService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

// ============================================================
// Agendamentos
// ============================================================

model Appointment {
  id            String            @id @default(uuid())
  clientId      String            @map("client_id")
  client        Client            @relation(fields: [clientId], references: [id])
  barberId      String            @map("barber_id")
  barber        Barber            @relation(fields: [barberId], references: [id])
  startTime     DateTime          @map("start_time")
  endTime       DateTime          @map("end_time")
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  totalPrice    Decimal           @default(0) @map("total_price") @db.Decimal(10, 2)
  totalDuration Int               @default(0) @map("total_duration")

  services AppointmentService[]
  review   Review?
  payment  Payment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([barberId, startTime])
  @@index([clientId])
  @@map("appointments")
}

// Join appointment <-> service, preservando preço/duração no momento da reserva
model AppointmentService {
  id                String  @id @default(uuid())
  appointmentId     String  @map("appointment_id")
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId         String  @map("service_id")
  service           Service @relation(fields: [serviceId], references: [id])
  priceAtBooking    Decimal @map("price_at_booking") @db.Decimal(10, 2)
  durationAtBooking Int     @map("duration_at_booking")

  @@unique([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

// ============================================================
// Avaliações e pagamentos
// ============================================================

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id])
  barberId      String   @map("barber_id")
  barber        Barber   @relation(fields: [barberId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([barberId])
  @@map("reviews")
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique @map("appointment_id")
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  provider      String?
  externalId    String?       @map("external_id")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

// ============================================================
// Disponibilidade
// ============================================================

model WorkingHour {
  id        String  @id @default(uuid())
  barberId  String  @map("barber_id")
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday   Int // 0 = domingo ... 6 = sábado
  startTime String  @map("start_time") // "09:00"
  endTime   String  @map("end_time") // "18:00"
  isActive  Boolean @default(true) @map("is_active")

  @@unique([barberId, weekday, startTime])
  @@index([barberId])
  @@map("working_hours")
}

model BlockedDate {
  id       String   @id @default(uuid())
  barberId String   @map("barber_id")
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startAt  DateTime @map("start_at")
  endAt    DateTime @map("end_at")
  reason   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([barberId, startAt])
  @@map("blocked_dates")
}

// ============================================================
// Configurações e notificações
// ============================================================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}
