# ==============================
# Backend — PRODUÇÃO (VPS)
# Copie para backend/.env e ajuste os valores reais.
# ==============================

NODE_ENV=production
PORT=4000

# Mesmo domínio do frontend (HTTPS)
CORS_ORIGIN=https://seudominio.com.br

# PostgreSQL de produção
DATABASE_URL="postgresql://guetto:SENHA_FORTE@localhost:5432/the_guetto?schema=public"

# Segredos JWT — GERE novos e fortes:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-em-producao
JWT_REFRESH_SECRET=troque-em-producao
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin inicial do seed (troque a senha após o primeiro login)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=julianoferrasso@hotmail.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
