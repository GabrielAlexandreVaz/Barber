# ==============================
# The Guetto Barber — Backend ENV
# ==============================

# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (ajuste usuário/senha conforme sua instalação local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_guetto?schema=public"

# JWT — gere segredos fortes (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-acesso
JWT_REFRESH_SECRET=troque-por-um-segredo-forte-de-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seed (usuário admin inicial)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL=julianoferrasso@hotmail.com
SEED_ADMIN_PASSWORD=Admin@123

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
